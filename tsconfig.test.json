// The tests are excluded from the build (nothing needs them compiled: vitest
// runs the .ts sources, and shipping out/test only bloated the .vsix), but they
// still have to type-check. `npm run typecheck` uses this config.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out", "src/test/fixtures"]
}
